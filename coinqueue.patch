+/* ── Insert Coin queue toggle ── */
+function setCoinQueueUI(on){
+    var tog=document.getElementById('cq-toggle');
+    var badge=document.getElementById('cq-badge');
+    if(on){ tog.classList.add('on'); badge.textContent='On'; badge.className='at-badge on'; }
+    else  { tog.classList.remove('on'); badge.textContent='Off'; badge.className='at-badge off'; }
+}
+function toggleCoinQueue(){
+    var tog=document.getElementById('cq-toggle');
+    if(tog.classList.contains('busy')) return;
+    var newVal=tog.classList.contains('on')?0:1;
+    tog.classList.add('busy');
+    postForm('coin_queue_set','enabled='+newVal,function(d){
+        tog.classList.remove('busy');
+        if(d.ok){ setCoinQueueUI(d.coin_queue_enabled); toastr.success('Insert Coin queue '+(d.coin_queue_enabled?'enabled':'disabled')); }
+        else toastr.error('Failed: '+(d.error||'unknown'));
+    });
+}
