From 2dba758b2715c14d7b068506c41ed8af9e57c5c2 Mon Sep 17 00:00:00 2001
From: Claude <claude@lmepisowifi.local>
Date: Tue, 8 Sep 2026 10:33:19 +0000
Subject: [PATCH 1/2] Add admin-configurable page reload after coin/resume
 success
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

New off-by-default toggle (Hotspot > Session Settings > Reload Page
After Success): when enabled, the customer portal forces a full page
reload right after

  - the Insert Coin modal closes with time successfully added (the
    "Done" -> complete/minutes>0 path), and
  - a paused session is resumed (manual Resume Time button or silent
    auto-resume)

instead of just re-polling status.sh in place. Some devices' captive
portal prompt never closes on its own until the page itself reloads
and the OS re-probes for internet access; this gives affected
operators an opt-in fix without forcing a reload (and interrupting
whatever the customer was doing) on every device.

Wiring, following the existing AUTO_RESUME_ENABLED toggle exactly:
  - defaults.env: new default, auto-seeds into globals.env on OTA
  - lmehspt.sh: hardcoded fallback default + write_coin_config() dump
    (the latter is required — without it the toggle silently resets
    to off on every hotspot restart/NodeMCU change/boot, since
    status.sh only ever reads it back from the regenerated
    coin_config.env cache, never globals.env directly)
  - www2/cgi-bin/hotspot.cgi: config_get/config_set read + write
  - www2/hotspot.html: admin toggle UI in the Session Settings card
  - hotspot/cgi-bin/status.sh: bool surfaced in all three status
    JSON shapes (online, paused, fresh) so it's cached before the
    codepaths that act on it ever fire
  - hotspot/index.html: cached on every status poll; consulted in
    the coin-complete success branch and doResume()'s success branch
---
 defaults.env              |  7 +++++++
 hotspot/cgi-bin/status.sh | 11 ++++++++---
 hotspot/index.html        | 10 ++++++++++
 lmehspt.sh                | 10 ++++++++++
 www2/cgi-bin/hotspot.cgi  |  4 ++++
 www2/hotspot.html         | 25 ++++++++++++++++++++++++-
 6 files changed, 63 insertions(+), 4 deletions(-)

diff --git a/defaults.env b/defaults.env
index fcbb9d6..6635198 100644
--- a/defaults.env
+++ b/defaults.env
@@ -51,6 +51,13 @@ ANTI_TETHER="1"
 LAN_ISOLATE="1"
 COIN_ENABLED="1"
 AUTO_PAUSE_ENABLED="1"
+# Off by default: most devices' captive-portal detection notices the new
+# session on its own once coins are added or a session is resumed. Some
+# devices' captive-portal prompt never closes on its own until the page is
+# reloaded and the OS re-probes for internet access, so this gives affected
+# operators an opt-in fix rather than reloading (and interrupting whatever
+# the customer was doing) for everyone.
+RELOAD_AFTER_TIME_ADDED_ENABLED="0"
 # iOS/Android randomize (or re-randomize on every reconnect) a device's WiFi
 # MAC for privacy. Since sessions/firewall rules here are keyed by MAC, a
 # customer whose phone hands out a new MAC mid-session looks like a brand
diff --git a/hotspot/cgi-bin/status.sh b/hotspot/cgi-bin/status.sh
index c2ace36..9cfa652 100755
--- a/hotspot/cgi-bin/status.sh
+++ b/hotspot/cgi-bin/status.sh
@@ -24,6 +24,11 @@ HOTSPOT_BR="br1"
 # MAC-randomization session-continuity fix (cookie-based device fingerprint)
 [ -f /lmepisowifi/hotspot/macfix.sh ] && . /lmepisowifi/hotspot/macfix.sh
 
+# Admin-configured (see hotspot.cgi's config_set / RELOAD_AFTER_TIME_ADDED_ENABLED).
+# Surfaced on every status poll, logged-in or not, so index.html has it
+# cached before the coin-complete/resume codepaths that actually act on it.
+RELOAD_BOOL="false"; [ "${RELOAD_AFTER_TIME_ADDED_ENABLED:-0}" = "1" ] && RELOAD_BOOL="true"
+
 _unlock() { rm -f /tmp/hotspot_session.lock/pid 2>/dev/null; rmdir /tmp/hotspot_session.lock 2>/dev/null; }
 _lock() {
     local i=0
@@ -138,7 +143,7 @@ if [ -n "$SESSION" ]; then
         USED=$(( TOTAL - REMAINING ))
         [ "$USED" -lt 0 ] && USED=0
 
-        $BB echo "{\"logged_in\":true,\"mac\":\"$CLIENT_MAC\",\"ip\":\"$CLIENT_IP\",\"remaining\":$REMAINING,\"total\":$TOTAL,\"used\":$USED,${CONN_JSON}${AVAIL_JSON}}"
+        $BB echo "{\"logged_in\":true,\"mac\":\"$CLIENT_MAC\",\"ip\":\"$CLIENT_IP\",\"remaining\":$REMAINING,\"total\":$TOTAL,\"used\":$USED,\"reload_after_time_added\":$RELOAD_BOOL,${CONN_JSON}${AVAIL_JSON}}"
         _unlock
         exit 0
     fi
@@ -157,8 +162,8 @@ if [ -n "$PAUSED" ]; then
     # still does the actual resume, so this flag never bypasses its
     # locking/atomic-write path, just who clicks the button.
     AR_BOOL="false"; [ "${AUTO_RESUME_ENABLED:-0}" = "1" ] && AR_BOOL="true"
-    $BB echo "{\"logged_in\":false,\"mac\":\"$CLIENT_MAC\",\"ip\":\"$CLIENT_IP\",\"has_paused\":true,\"remaining\":$REMAINING,\"total\":$TOTAL,\"auto_resume\":$AR_BOOL,${CONN_JSON}${AVAIL_JSON}}"
+    $BB echo "{\"logged_in\":false,\"mac\":\"$CLIENT_MAC\",\"ip\":\"$CLIENT_IP\",\"has_paused\":true,\"remaining\":$REMAINING,\"total\":$TOTAL,\"auto_resume\":$AR_BOOL,\"reload_after_time_added\":$RELOAD_BOOL,${CONN_JSON}${AVAIL_JSON}}"
 else
-    $BB echo "{\"logged_in\":false,\"mac\":\"$CLIENT_MAC\",\"ip\":\"$CLIENT_IP\",${CONN_JSON}${AVAIL_JSON}}"
+    $BB echo "{\"logged_in\":false,\"mac\":\"$CLIENT_MAC\",\"ip\":\"$CLIENT_IP\",\"reload_after_time_added\":$RELOAD_BOOL,${CONN_JSON}${AVAIL_JSON}}"
 fi
 _unlock
diff --git a/hotspot/index.html b/hotspot/index.html
index 09b561e..bd1b6d7 100644
--- a/hotspot/index.html
+++ b/hotspot/index.html
@@ -1408,6 +1408,7 @@ var _coinPendingWait  = false;
 var _cachedRates      = '';      
 var _coinSuspended    = false;
 var _autoResuming     = false;   // guards against firing doResume(true) twice while one is in flight
+var _reloadAfterTimeAdded = false; // admin-configured (status.sh); see checkStatus()
 var _coinCooldownRemaining = 0;
 var _coinNodemcus     = [];      // [{id,title}, ...] from coin.sh's config action — only >1 entry shows the picker
 var _coinNodeID       = null;    // which unit the in-flight/active session targets
@@ -1671,6 +1672,7 @@ function checkStatus() {
     .then(function(r) { return r.json(); })
     .then(function(d) {
       updateAvailCoinsRow(d);
+      _reloadAfterTimeAdded = (d.reload_after_time_added === true || d.reload_after_time_added === '1' || d.reload_after_time_added === 1);
       if (d.logged_in) {
         renderDeviceInfo(d, 's');
         if (!_coinSID && !_queuePollID && !_coinPendingWait) show('v-status');
@@ -1739,6 +1741,10 @@ function doResume(auto) {
     _autoResuming = false;
     if (d.ok) {
       show('v-status');
+      // Same captive-portal-compatibility reload as the coin-success path
+      // (see RELOAD_AFTER_TIME_ADDED_ENABLED) — applies to both a manual
+      // Resume Time tap and a silent auto-resume.
+      if (_reloadAfterTimeAdded) { location.reload(); return; }
       checkStatus();
     } else if (auto) {
       // Silent by design — the admin turned this on so the customer never
@@ -2485,6 +2491,10 @@ function startCoinPoll() {
             setTimeout(function() {
               _coinSID = null; 
               closeCoinModalUI();
+              // Some devices' captive-portal prompt never closes on its own
+              // until the page reloads and the OS re-probes for internet
+              // access — admin opt-in (see RELOAD_AFTER_TIME_ADDED_ENABLED).
+              if (_reloadAfterTimeAdded) { location.reload(); return; }
               checkStatus();
             }, 1500);
           } else {
diff --git a/lmehspt.sh b/lmehspt.sh
index 21e14ce..bbccbe3 100755
--- a/lmehspt.sh
+++ b/lmehspt.sh
@@ -60,6 +60,13 @@ AUTO_PAUSE_ENABLED="1"
 # same resume=1 request the button would, the moment the device's next
 # status poll lands after it reconnects — no tap needed.
 AUTO_RESUME_ENABLED="0"
+# Off by default — see defaults.env for the full rationale. When on,
+# index.html forces a full page reload right after a coin top-up finishes
+# ("Done" closing the Insert Coin modal with time added) or a paused
+# session is resumed, instead of just re-polling status.sh in place. Some
+# devices' captive-portal UI otherwise never notices it already has
+# internet access until the page itself reloads and the OS re-probes.
+RELOAD_AFTER_TIME_ADDED_ENABLED="0"
 BOOT_MARKER="/tmp/hotspot_boot.mark"
 ACTIVITY_FILE="/tmp/hotspot_activity.txt"
 PER_USER_RATE="5mbit"
@@ -1583,6 +1590,9 @@ write_coin_config() {
         # only sources this cache file (never globals.env directly), so it
         # would then see AUTO_RESUME_ENABLED as unset and fall back to off.
         printf 'AUTO_RESUME_ENABLED="%s"\n' "${AUTO_RESUME_ENABLED:-0}"
+        # Same "without this line" reasoning as AUTO_RESUME_ENABLED above —
+        # status.sh only ever sees this var via coin_config.env.
+        printf 'RELOAD_AFTER_TIME_ADDED_ENABLED="%s"\n' "${RELOAD_AFTER_TIME_ADDED_ENABLED:-0}"
         printf 'PORTAL_IP="%s"\n'           "$PORTAL_IP"
         printf 'PORTAL_PORT="%s"\n'         "$PORTAL_PORT"
         printf 'DHCP_START="%s"\n'          "$DHCP_START"
diff --git a/www2/cgi-bin/hotspot.cgi b/www2/cgi-bin/hotspot.cgi
index 8b865a4..1bf40d8 100755
--- a/www2/cgi-bin/hotspot.cgi
+++ b/www2/cgi-bin/hotspot.cgi
@@ -591,6 +591,8 @@ if echo "$QS" | $BB grep -q "action=config_get"; then
     AP_BOOL="false"; [ "${AP:-1}" = "1" ] && AP_BOOL="true"
     AR="${AUTO_RESUME_ENABLED:-$(read_lmehspt_var AUTO_RESUME_ENABLED)}"
     AR_BOOL="false"; [ "${AR:-0}" = "1" ] && AR_BOOL="true"
+    RL="${RELOAD_AFTER_TIME_ADDED_ENABLED:-$(read_lmehspt_var RELOAD_AFTER_TIME_ADDED_ENABLED)}"
+    RL_BOOL="false"; [ "${RL:-0}" = "1" ] && RL_BOOL="true"
     ES="${EQUAL_SHARING_ENABLED:-$(read_lmehspt_var EQUAL_SHARING_ENABLED)}"
     ES_BOOL="false"; [ "${ES:-0}" = "1" ] && ES_BOOL="true"
     CE="${COIN_ENABLED:-$(read_lmehspt_var COIN_ENABLED)}"
@@ -644,6 +646,7 @@ if echo "$QS" | $BB grep -q "action=config_get"; then
 \"inactivity_timeout\":\"$(esc_json "$IT")\",
 \"auto_pause_enabled\":$AP_BOOL,
 \"auto_resume_enabled\":$AR_BOOL,
+\"reload_after_time_added\":$RL_BOOL,
 \"equal_sharing_enabled\":$ES_BOOL,
 \"coin_enabled\":\"$(esc_json "$CE")\",
 \"coin_on\":$COIN_ON,
@@ -716,6 +719,7 @@ if echo "$QS" | $BB grep -q "action=config_set"; then
     apply_if "INACTIVITY_TIMEOUT"  "$(fget inactivity_timeout)"
     apply_if "AUTO_PAUSE_ENABLED"  "$(fget auto_pause_enabled)"
     apply_if "AUTO_RESUME_ENABLED" "$(fget auto_resume_enabled)"
+    apply_if "RELOAD_AFTER_TIME_ADDED_ENABLED" "$(fget reload_after_time_added)"
     apply_if "EQUAL_SHARING_ENABLED" "$(fget equal_sharing_enabled)"
     apply_if "NODEMCU_IP"          "$(fget nodemcu_ip)"
     apply_if "NODEMCU_MAC"         "$(fget nodemcu_mac)"
diff --git a/www2/hotspot.html b/www2/hotspot.html
index 361f55e..959b21a 100644
--- a/www2/hotspot.html
+++ b/www2/hotspot.html
@@ -232,6 +232,16 @@
                     </div>
                     <div class="field-hint">Skip the Resume Time button — restore remaining time as soon as a paused device is back online</div>
                 </div>
+                <!-- Reload page after coin/resume success (device compatibility) -->
+                <div class="col-sm-6">
+                    <div class="d-flex align-items-center justify-content-between">
+                        <div style="font-weight:500;">Reload Page After Success</div>
+                        <div id="rl-toggle" class="wlan-toggle" onclick="toggleReloadAfterSuccessUI()" title="Force a page reload right after coins/vouchers add time or a session is resumed">
+                            <div class="wlan-toggle-knob"></div>
+                        </div>
+                    </div>
+                    <div class="field-hint">Off by default. Turn on only if some of your customers' phones keep the "Sign in to network" prompt open after paying — this forces a reload so the OS re-checks internet access.</div>
+                </div>
             </div>
             <hr class="my-3" style="border-color:var(--border-color);">
             <div class="d-flex gap-2">
@@ -462,6 +472,7 @@ function loadConfig(){
             document.getElementById('r-inactivity').value = d.inactivity_timeout||'300';
             setAutoPauseUI(d.auto_pause_enabled===true||d.auto_pause_enabled==='1'||d.auto_pause_enabled===1);
             setAutoResumeUI(d.auto_resume_enabled===true||d.auto_resume_enabled==='1'||d.auto_resume_enabled===1);
+            setReloadAfterSuccessUI(d.reload_after_time_added===true||d.reload_after_time_added==='1'||d.reload_after_time_added===1);
             setEqualShareUI(d.equal_sharing_enabled===true||d.equal_sharing_enabled==='1'||d.equal_sharing_enabled===1);
             document.getElementById('c-coin-timeout').value  = d.coin_timeout||'';
             document.getElementById('c-strike-threshold').value = d.coin_strike_threshold||'';
@@ -524,10 +535,12 @@ function saveSessionSettings(){
     var ina = document.getElementById('r-inactivity').value.trim();
     var apOn = document.getElementById('ap-toggle').classList.contains('on');
     var arOn = document.getElementById('ar-toggle').classList.contains('on');
+    var rlOn = document.getElementById('rl-toggle').classList.contains('on');
     showOverlay('Saving…');
     var body='inactivity_timeout='+encodeURIComponent(ina)
             +'&auto_pause_enabled='+(apOn?'1':'0')
-            +'&auto_resume_enabled='+(arOn?'1':'0');
+            +'&auto_resume_enabled='+(arOn?'1':'0')
+            +'&reload_after_time_added='+(rlOn?'1':'0');
     postForm('config_set', body, function(d){
         hideOverlay();
         if(d.ok) toastr.success('Session settings saved');
@@ -557,6 +570,16 @@ function toggleAutoResumeUI(){
     setAutoResumeUI(!tog.classList.contains('on'));
 }
 
+/* ── Reload-after-success switch (local UI state; persisted via Save & Apply) ── */
+function setReloadAfterSuccessUI(on){
+    var tog=document.getElementById('rl-toggle');
+    if(on) tog.classList.add('on'); else tog.classList.remove('on');
+}
+function toggleReloadAfterSuccessUI(){
+    var tog=document.getElementById('rl-toggle');
+    setReloadAfterSuccessUI(!tog.classList.contains('on'));
+}
+
 /* ── Anti-tethering toggle ── */
 function setAntiTetherUI(on){
     var tog=document.getElementById('at-toggle');
-- 
