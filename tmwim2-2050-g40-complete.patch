From b26e7bd0ac7349f84f56e542152b5dfb87d92a51 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 30 Sep 2026 10:45:39 +0000
Subject: [PATCH 04/10] warn on publicly-known coin-slot PSK; crypto RNG for
 voucher codes

COIN_PSK signs coin credits (md5 over PSK:SID:AMOUNT). The values that ship
in this repo (defaults.env "lmepisowifi", the lmehspt.sh fallback, the
NodeMCU setup-page placeholder) are public, so a box that never changed it has
no secret protecting coin credits beyond the source-IP/MAC check.

Auto-rotating it would silently break pairing with every already-flashed
NodeMCU, so do what the default-password warning does instead:
lme.cgi?action=account_status now also returns a boolean default_coin_psk
(never the PSK itself), checked against the primary PSK in globals.env and any
enabled extra unit, and index.html shows a banner linking to the NodeMCU page.
Absent COIN_PSK (no primary configured) and a missing globals.env report false.

hotspot-vouchers.html quickGen() built voucher codes with Math.random(), which
is predictable from a handful of observed outputs and a voucher is a bearer
credential. Use crypto.getRandomValues; the 32-symbol alphabet makes "& 31"
unbiased.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 www2/cgi-bin/lme.cgi       | 34 +++++++++++++++++++++++++++++++++-
 www2/hotspot-vouchers.html |  7 ++++++-
 www2/index.html            | 17 ++++++++++++++++-
 3 files changed, 55 insertions(+), 3 deletions(-)

diff --git a/www2/cgi-bin/lme.cgi b/www2/cgi-bin/lme.cgi
index f34c121..1a5f1d8 100755
--- a/www2/cgi-bin/lme.cgi
+++ b/www2/cgi-bin/lme.cgi
@@ -425,9 +425,41 @@ if [ "$REQUEST_METHOD" = "GET" ]; then
             IS_DEFAULT_PW=false
         fi
 
+        # --- BEGIN default_coin_psk ---
+        # Is the coin-slot shared secret (COIN_PSK) still one of the values that
+        # ships in this project's PUBLIC source (defaults.env / lmehspt.sh /
+        # the NodeMCU setup-page placeholder)? Anyone can read those, so a box
+        # still using one has no secret protecting coin credits beyond the
+        # IP/MAC check. Only a boolean leaves this script -- never the PSK.
+        # Reads globals.env only: if COIN_PSK is absent there the box has no
+        # primary NodeMCU configured (see seed_globals in lmehspt.sh), and
+        # lmehspt.sh's own copy is rewritten in place when an admin changes the
+        # PSK, so comparing against it would false-positive. Fails safe to false.
+        _is_public_psk() {
+            case "$1" in
+                "2Au6410y1O15YV9610wHmr52"|"lmepisowifi"|"ReplaceWithSomethingLongAndRandom!") return 0 ;;
+            esac
+            return 1
+        }
+        IS_DEFAULT_PSK=false
+        _GENV="${LME_GLOBALS_ENV:-/lmepisowifi/globals.env}"
+        _XTRA="${LME_NODEMCU_EXTRA:-/lmepisowifi/hotspot_data/nodemcus_extra.txt}"
+        CUR_PSK=$(busybox grep -m1 '^COIN_PSK=' "$_GENV" 2>/dev/null \
+            | busybox sed 's/^COIN_PSK=//; s/\r$//; s/^"\(.*\)"$/\1/; s/^'"'"'\(.*\)'"'"'$/\1/')
+        if [ -n "$CUR_PSK" ] && _is_public_psk "$CUR_PSK"; then
+            IS_DEFAULT_PSK=true
+        elif [ -f "$_XTRA" ]; then
+            # extra units: ID|TITLE|IP|MAC|PORT|PSK|ENABLED -- only enabled ones matter
+            for _xp in $(busybox awk -F'|' '$7!="0" && $6!="" {print $6}' "$_XTRA" 2>/dev/null | busybox tr -d '\r' | busybox tr ' ' '\001'); do
+                _xp=$(printf '%s' "$_xp" | busybox tr '\001' ' ')
+                _is_public_psk "$_xp" && { IS_DEFAULT_PSK=true; break; }
+            done
+        fi
+        # --- END default_coin_psk ---
+
         printf "Status: 200 OK\r\n"
         printf "Content-Type: application/json\r\n\r\n"
-        printf '{"suser_name":"%s","default_password":%s}' "$ESC_SUSER" "$IS_DEFAULT_PW"
+        printf '{"suser_name":"%s","default_password":%s,"default_coin_psk":%s}' "$ESC_SUSER" "$IS_DEFAULT_PW" "$IS_DEFAULT_PSK"
         exit 0
     fi
 
diff --git a/www2/hotspot-vouchers.html b/www2/hotspot-vouchers.html
index 65b921b..7873501 100644
--- a/www2/hotspot-vouchers.html
+++ b/www2/hotspot-vouchers.html
@@ -172,7 +172,12 @@ function addVoucher(){
 function quickGen(mins){
     var chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
     var code='';
-    for (var i=0;i<8;i++) code+=chars[Math.floor(Math.random()*chars.length)];
+    // crypto RNG, not Math.random(): a voucher code is a bearer credential, and
+    // Math.random() is predictable from a few observed outputs. The alphabet is
+    // exactly 32 symbols, so "& 31" maps 256 byte values evenly (no modulo bias).
+    var rnd=new Uint8Array(8);
+    (window.crypto||window.msCrypto).getRandomValues(rnd);
+    for (var i=0;i<8;i++) code+=chars[rnd[i]&31];
     document.getElementById('v-code').value=code;
     document.getElementById('v-duration').value=mins;
     addVoucher();
diff --git a/www2/index.html b/www2/index.html
index 18c6917..f314b49 100644
--- a/www2/index.html
+++ b/www2/index.html
@@ -136,6 +136,18 @@
                 <a href="/accounts.html" class="btn btn-sm btn-danger">Change Password</a>
             </div>
         </div>
+        <!-- Shown by checkDefaultPassword() while the coin-slot PSK is a value published in the public source -->
+        <div id="default-psk-warning" class="alert alert-warning mb-3" role="alert" style="display:none">
+            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
+                <div>
+                    <strong>Default coin-slot PSK in use.</strong>
+                    The shared secret that signs coin credits is still a value published in the project's public source,
+                    so it is not secret. Set your own on the NodeMCU page <em>and</em> enter the same PSK in the
+                    NodeMCU's own setup page &mdash; if the two differ, coins stop crediting.
+                </div>
+                <a href="/hotspot-nodemcus.html" class="btn btn-sm btn-warning">Change PSK</a>
+            </div>
+        </div>
         <div class="row g-3" id="dash-grid">
             <!-- Cards injected by JS in layout order -->
         </div>
@@ -304,7 +316,8 @@
 
     // ── Data fetchers ─────────────────────────────────────────────────────────
     // Warn when the admin password is still the factory default (server compares
-    // SUSER_PASSWORD to DEFAULT_SUSER_PASSWORD and only returns a boolean). Runs
+    // SUSER_PASSWORD to DEFAULT_SUSER_PASSWORD and only returns a boolean), and
+    // likewise when the coin-slot PSK is a publicly-known default. Runs
     // once per page load; any failure just leaves the banner hidden.
     function checkDefaultPassword() {
         fetch('/cgi-bin/lme.cgi?action=account_status', {cache:'no-store'})
@@ -312,6 +325,8 @@
             .then(function(d){
                 var el = document.getElementById('default-pw-warning');
                 if (el) el.style.display = (d && d.default_password === true) ? '' : 'none';
+                var ep = document.getElementById('default-psk-warning');
+                if (ep) ep.style.display = (d && d.default_coin_psk === true) ? '' : 'none';
             })
             .catch(function(){});
     }
-- 
