From c8502e851fefa03648311c595280824da52e55be Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 30 Sep 2026 10:45:39 +0000
Subject: [PATCH 02/10] harden admin sessions: random session IDs, enforce
 expiry on media CGIs

auth.cgi built the session ID as sha256(date + $RANDOM + username). $RANDOM is
15 bits and the other two inputs are guessable, so a hotspot customer who can
reach :8080 could brute-force valid IDs against check_auth.cgi. Take 32 bytes
from /dev/urandom instead, and fail closed (back to the login page) if the
read comes back short, rather than hashing an empty string into one constant,
publicly-known "session".

portal_img.cgi and portal_audio.cgi declared SESSION_TIMEOUT but never
applied it, so an expired session cookie kept working on those two endpoints
until the next login happened to sweep /tmp/sessions. Enforce it the same way
hotspot.cgi does.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 www2/cgi-bin/auth.cgi         | 19 +++++++++++++++++--
 www2/cgi-bin/portal_audio.cgi | 14 ++++++++++++++
 www2/cgi-bin/portal_img.cgi   | 14 ++++++++++++++
 3 files changed, 45 insertions(+), 2 deletions(-)

diff --git a/www2/cgi-bin/auth.cgi b/www2/cgi-bin/auth.cgi
index 671824d..e9f2b31 100755
--- a/www2/cgi-bin/auth.cgi
+++ b/www2/cgi-bin/auth.cgi
@@ -62,8 +62,23 @@ if [ -n "$FORM_USER" ] && [ "$FORM_USER" = "$REAL_USER" ] && [ "$FORM_PASS" = "$
     # from anyone starting from a stale count.
     lockout_reset
 
-    # Generate unique session ID
-    SESSION_ID=$(printf "%s%s%s" "$(date)" "$RANDOM" "$FORM_USER" | busybox sha256sum | busybox cut -d' ' -f1)
+    # Generate the session ID from 256 bits of kernel randomness. It used to be
+    # sha256(date + $RANDOM + username): $RANDOM is only 15 bits, and the date
+    # (to the second) and username are both guessable, so a hotspot customer
+    # who can reach this port could enumerate valid session IDs offline-ish
+    # via check_auth.cgi. Fail CLOSED if /dev/urandom can't deliver exactly
+    # 32 bytes -- hashing an empty read would yield one constant, publicly
+    # known "session ID" for every login.
+    SESSION_ID=$(busybox dd if=/dev/urandom bs=32 count=1 2>/dev/null \
+        | busybox od -An -v -tx1 | busybox tr -d ' \n')
+    case "$SESSION_ID" in
+        *[!0-9a-f]*|"") SESSION_ID="" ;;
+    esac
+    if [ "${#SESSION_ID}" -ne 64 ]; then
+        printf "Status: 302 Found\r\n"
+        printf "Location: /login.html?error=1\r\n\r\n"
+        exit 0
+    fi
 
     # Ensure session directory exists and write timestamp for this session
     mkdir -p /tmp/sessions
diff --git a/www2/cgi-bin/portal_audio.cgi b/www2/cgi-bin/portal_audio.cgi
index d984539..adbe100 100755
--- a/www2/cgi-bin/portal_audio.cgi
+++ b/www2/cgi-bin/portal_audio.cgi
@@ -24,6 +24,20 @@ if [ -z "$BROWSER_SESSION" ] || [ ! -f "$SESSION_FILE" ]; then
     exit 0
 fi
 
+# SESSION_TIMEOUT was declared above but never enforced here, so a session
+# cookie kept working on this endpoint long after it had expired everywhere
+# else (expired session files are only swept at the next login). Same
+# expiry rule as hotspot.cgi/check_auth.cgi; an empty file is a concurrent
+# write in progress, not an expired session.
+_LAST=$(cat "$SESSION_FILE" 2>/dev/null | busybox tr -d '\r\n')
+_NOW=$(date +%s)
+case "$_LAST" in "") _LAST=$_NOW ;; *[!0-9]*) _LAST=0 ;; esac
+if [ $((_NOW - _LAST)) -gt $SESSION_TIMEOUT ]; then
+    rm -f "$SESSION_FILE"
+    printf "Status: 403 Forbidden\r\nContent-Type: text/plain\r\n\r\nForbidden"
+    exit 0
+fi
+
 # Sanitize: only alphanumeric, dot, underscore, hyphen — no path traversal
 FILE=$(echo "$QUERY_STRING" | busybox sed -n 's/.*file=\([^&]*\).*/\1/p' | busybox tr -cd 'a-zA-Z0-9._-')
 [ -z "$FILE" ] && { printf "Status: 400 Bad Request\r\nContent-Type: text/plain\r\n\r\nBad Request"; exit 0; }
diff --git a/www2/cgi-bin/portal_img.cgi b/www2/cgi-bin/portal_img.cgi
index febc3e1..d5252fb 100755
--- a/www2/cgi-bin/portal_img.cgi
+++ b/www2/cgi-bin/portal_img.cgi
@@ -24,6 +24,20 @@ if [ -z "$BROWSER_SESSION" ] || [ ! -f "$SESSION_FILE" ]; then
     exit 0
 fi
 
+# SESSION_TIMEOUT was declared above but never enforced here, so a session
+# cookie kept working on this endpoint long after it had expired everywhere
+# else (expired session files are only swept at the next login). Same
+# expiry rule as hotspot.cgi/check_auth.cgi; an empty file is a concurrent
+# write in progress, not an expired session.
+_LAST=$(cat "$SESSION_FILE" 2>/dev/null | busybox tr -d '\r\n')
+_NOW=$(date +%s)
+case "$_LAST" in "") _LAST=$_NOW ;; *[!0-9]*) _LAST=0 ;; esac
+if [ $((_NOW - _LAST)) -gt $SESSION_TIMEOUT ]; then
+    rm -f "$SESSION_FILE"
+    printf "Status: 403 Forbidden\r\nContent-Type: text/plain\r\n\r\nForbidden"
+    exit 0
+fi
+
 # Sanitize: only allow alphanumeric, dot, underscore, hyphen — no path traversal
 FILE=$(echo "$QUERY_STRING" | busybox sed -n 's/.*file=\([^&]*\).*/\1/p' | busybox tr -cd 'a-zA-Z0-9._-')
 [ -z "$FILE" ] && { printf "Status: 400 Bad Request\r\nContent-Type: text/plain\r\n\r\nBad Request"; exit 0; }
