+
+  <!--
+    Operator custom CSS (www2 > Hotspot > Portal > Custom CSS).
+    It is added as its OWN <link>, after every built-in style, so (a) it wins
+    the cascade at equal specificity and (b) a mistake inside it can only ever
+    hurt the custom rules themselves — never the stock stylesheet above.
+
+      /?nocss=1      safe mode: skip the custom CSS entirely
+      /?cssdraft=1   (admin preview) load the unsaved draft instead
+      /?cssprev=1    (admin preview, inside the www2 iframe) block anything that
+                     would change real state and enable the preview hooks
+
+    An automatic on-device check (script at the end of <body>) drops the custom
+    CSS for a visit if it ever hides or breaks the ways to get online.
+  -->
+  <script>
+  (function () {
+    var qs      = window.location.search;
+    var safe    = /[?&]nocss=1(&|$)/.test(qs);
+    var draft   = /[?&]cssdraft=1(&|$)/.test(qs);
+    var preview = /[?&]cssprev=1(&|$)/.test(qs) && window.parent !== window;
+    window.__lmeCss = { link: null, preview: preview };
+
+    // The admin preview is the real, live portal page inside an iframe — make
+    // sure clicking around in it can never start/cancel a coin session, log a
+    // device in or pause it.
+    if (preview && window.fetch) {
+      var realFetch = window.fetch;
+      window.fetch = function (u) {
+        var url = String(u);
+        if (/\/cgi-bin\/(login|logout|coin_result)\.sh/.test(url) ||
+            /\/cgi-bin\/coin\.sh\?(?:[^#]*&)?action=(start|cancel)\b/.test(url)) {
+          return Promise.reject(new Error('disabled in preview'));
+        }
+        return realFetch.apply(this, arguments);
+      };
+    }
+
+    if (safe) return;
+    // A visit that already tripped the safety check keeps the stock look
+    try { if (!preview && window.sessionStorage.getItem('lme_css_bad') === '1') return; } catch (e) {}
+
+    var l = document.createElement('link');
+    l.rel  = 'stylesheet';
+    l.id   = 'custom-css';
+    l.href = '/cgi-bin/portal_css.sh' + (draft ? '?draft=1&_=' + new Date().getTime() : '');
+    document.head.appendChild(l);
+    window.__lmeCss.link = l;
+  })();
+  </script>
 </head>
 <body>
 
@@ -2754,5 +2804,206 @@ checkCoinEnabled();
   }).catch(function(){});
 })();
 </script>
