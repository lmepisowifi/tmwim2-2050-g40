+            if (r.ok) { info.enabled = want; toastr.success(want ? 'Custom CSS is on.' : 'Custom CSS is off (kept, just not used).'); }
+            else { toastr.error(errText(r.error)); box.checked = !!info.enabled; }
+        }).catch(function () { toastr.error('Network error.'); box.checked = !!info.enabled; }).then(function () { busy = false; refresh(); });
+    });
+    $('css-snip').addEventListener('change', function () {
+        var s = SNIPS[this.value]; this.value = '';
+        if (!s) return;
+        var v = ed.value, a = ed.selectionStart || 0, pre = v.slice(0, a), post_ = v.slice(ed.selectionEnd || a);
+        if (pre && !/\n\n$/.test(pre)) pre += /\n$/.test(pre) ? '\n' : '\n\n';
+        ed.value = pre + s + (post_ && !/^\n/.test(post_) ? '\n' + post_ : post_);
+        ed.focus(); ed.setSelectionRange(pre.length, pre.length + s.length);
+        ed.dispatchEvent(new Event('input'));
+    });
+    window.addEventListener('beforeunload', function (e) {
+        if (loaded && dirty()) { e.preventDefault(); e.returnValue = ''; }
+    });
+
+    refresh();
+    loadAll().then(startPreview);
+})();
+</script>
 </body>
 </html>
 
