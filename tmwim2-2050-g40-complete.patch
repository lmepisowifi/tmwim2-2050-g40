From 105992718630c32211c50735eafd514f165e84f0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 3 Oct 2026 10:36:30 +0000
Subject: [PATCH 09/10] ota check: name a certificate failure instead of "could
 not reach server"

With certificate verification on, a device whose clock has not synced fails
every HTTPS fetch with wget exit 5. do_check collapsed that into "could not
reach update server (jsDelivr/GitHub)", so nothing on the page said why or
that the new "Skip certificate check" switch exists. Report exit 5 as a
certificate/clock problem and point at the switch. Every other failure keeps
its existing message.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 ota.sh | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/ota.sh b/ota.sh
index 2faa566..ccb9f8c 100755
--- a/ota.sh
+++ b/ota.sh
@@ -379,8 +379,13 @@ do_check() {
         printf '{"error":"OTA_MANIFEST_URL not set","current":"%s"}\n' "$(json_esc "$_cur")"
         return 0
     fi
-    if ! fetch "$OTA_MANIFEST_URL" "$DL/manifest.txt"; then
-        if grep -Eqi 'rate.limit|Too Many Requests|terms.*service' "$DL/manifest.txt" 2>/dev/null; then
+    fetch "$OTA_MANIFEST_URL" "$DL/manifest.txt"; _frc=$?
+    if [ "$_frc" -ne 0 ]; then
+        if [ "$_frc" -eq 5 ]; then
+            # wget exit 5 = TLS certificate verification failed (see fetch()).
+            # Name it, so the admin knows about the "Skip certificate check" switch.
+            printf '{"error":"HTTPS certificate check failed - the device clock is probably wrong. Fix the time, or turn on Skip certificate check below","current":"%s"}\n' "$(json_esc "$_cur")"
