+        var c = $('css-count');
+        c.textContent = n + ' / ' + MAX + ' bytes';
+        c.style.color = n > MAX ? '#ef4444' : '';
+        if (!loaded) { el.textContent = ''; return; }
+        if (dirty())              { el.textContent = 'Unsaved changes'; el.style.color = '#fbbf24'; }
+        else if (!info.has_css)   { el.textContent = 'Stock look (no custom CSS)'; el.style.color = ''; }
+        else if (!info.enabled)   { el.textContent = 'Saved \u00b7 switched off'; el.style.color = ''; }
+        else                      { el.textContent = 'Saved \u00b7 live on the portal'; el.style.color = '#4ade80'; }
+    }
+    function refresh() {
+        var en = $('css-enabled');
+        en.checked = !!info.enabled; en.disabled = !loaded || busy || !info.has_css;
+        $('css-save').disabled = !loaded || busy || !dirty();
+        $('css-discard').disabled = !loaded || busy || !dirty();
+        $('css-undo').disabled = !loaded || busy || !info.has_prev;
+        $('css-reset').disabled = !loaded || busy || !info.has_css;
+        setStatus();
+    }
+    function showErrors(list) {
+        var box = $('css-errors');
+        box.textContent = '';
+        if (!list || !list.length) { box.style.display = 'none'; return; }
+        list.forEach(function (line) {
+            var row = document.createElement('div'), m = /^line (\d+): ([\s\S]*)$/.exec(line);
+            if (m) {
+                var a = document.createElement('a'); a.href = '#'; a.textContent = 'line ' + m[1];
+                a.addEventListener('click', function (ev) { ev.preventDefault(); gotoLine(+m[1]); });
+                row.appendChild(a); row.appendChild(document.createTextNode(': ' + m[2]));
+            } else { row.textContent = line; }
+            box.appendChild(row);
+        });
+        box.style.display = 'block';
+    }
+    function gotoLine(n) {
+        var lines = ed.value.split('\n'), pos = 0, i;
+        for (i = 0; i < n - 1 && i < lines.length; i++) pos += lines[i].length + 1;
+        ed.focus();
+        ed.setSelectionRange(pos, pos + (lines[n - 1] ? lines[n - 1].length : 0));
+        ed.scrollTop = Math.max(0, (n - 3) * (parseFloat(getComputedStyle(ed).lineHeight) || 18));
+    }
+
+    /* ── Draft pipeline (validate + preview) ── */
+    function pushDraft() {
+        var my = ++seq, text = ed.value, n = utf8len(text);
+        if (n > MAX) { showErrors(['CSS is ' + n + ' bytes; the limit is ' + MAX]); return Promise.resolve({ ok: false }); }
+        return api('portal_css_draft', enc(text)).then(function (d) {
+            if (my !== seq) return d;                       // a newer edit is already on its way
+            if (d.ok) { showErrors([]); if (pv.ready) post({ cmd: 'reload' }); }
+            else if (d.error === 'invalid_css') showErrors(d.details || ['Invalid CSS.']);
+            else showErrors([errText(d.error)]);
+            return d;
+        }).catch(function () {
+            if (my === seq) showErrors(['Could not reach the device (is your admin session still active?).']);
+            return { ok: false };
+        });
+    }
+    ed.addEventListener('input', function () {
+        refresh();
+        clearTimeout(draftTimer);
+        draftTimer = setTimeout(pushDraft, 700);
+    });
+
+    /* ── Preview iframe ── */
+    function post(msg) {
+        msg.lmePreview = true;
+        try { frame.contentWindow.postMessage(msg, '*'); } catch (e) {}
+    }
+    function showGuard(issues) {
+        var g = $('css-guard');
+        g.textContent = '';
+        if (!issues || !issues.length) { g.style.display = 'none'; return; }
+        var b = document.createElement('b');
+        b.textContent = 'Customers\u2019 phones would switch your CSS off here: ';
+        g.appendChild(b); g.appendChild(document.createTextNode(issues.join('; ') + '.'));
+        g.style.display = 'block';
+    }
+    var NAMES = { login: 'Login screen', status: 'Connected screen', rates: 'Rates window', coin: 'Coin window' };
+    function onAudit(results) {
+        var bad = [], k;
+        for (k in NAMES) if (results && results[k] && results[k].length) bad.push(NAMES[k] + ' \u2014 ' + results[k].join(', '));
+        $('css-audit-res').textContent = bad.length ? '' : '\u2713 All 4 screens OK';
+        $('css-audit-res').style.color = '#4ade80';
+        showGuard(bad.length ? bad.map(function (s) { return s; }) : []);
+        var cb = pv.auditCb; pv.auditCb = null;
+        if (cb) cb(bad);
+    }
+    function runAudit(cb) {
+        if (!pv.ready) { cb(null); return; }
+        pv.auditCb = cb;
+        $('css-audit-res').textContent = 'Checking\u2026'; $('css-audit-res').style.color = '';
+        post({ cmd: 'audit' });
+        setTimeout(function () { if (pv.auditCb === cb) { pv.auditCb = null; cb(null); } }, 9000);
+    }
+    window.addEventListener('message', function (e) {
+        var d = e.data;
+        if (e.source !== frame.contentWindow || !d || typeof d !== 'object') return;
+        if (d.lmeCssReady) {
+            pv.ready = true; frameMsg.style.display = 'none'; $('css-audit').disabled = false;
+            post({ cmd: 'theme', theme: pv.theme }); post({ cmd: 'state', state: pv.state });
+        } else if (d.lmeCssGuard) { if (!pv.auditCb) showGuard(d.issues); }
+        else if (d.lmeCssAudit) onAudit(d.results);
+    });
+    function pick(group, attr, val) {
+        var bs = $(group).querySelectorAll('button'), i;
+        for (i = 0; i < bs.length; i++) bs[i].classList.toggle('active', bs[i].getAttribute(attr) === val);
+    }
+    $('css-states').addEventListener('click', function (e) {
+        var b = e.target.closest ? e.target.closest('button') : null; if (!b) return;
+        pv.state = b.getAttribute('data-state'); pick('css-states', 'data-state', pv.state); post({ cmd: 'state', state: pv.state });
+    });
+    $('css-themes').addEventListener('click', function (e) {
+        var b = e.target.closest ? e.target.closest('button') : null; if (!b) return;
+        pv.theme = b.getAttribute('data-theme'); pick('css-themes', 'data-theme', pv.theme); post({ cmd: 'theme', theme: pv.theme });
+        frame.parentNode.style.background = (pv.theme === 'light') ? '#e2e8f0' : '#0f0f11';
+    });
+    $('css-audit').addEventListener('click', function () { runAudit(function () {}); });
+
+    function startPreview() {
+        api('config_get').then(function (c) {
+            var ip = c && c.portal_ip, port = c && c.portal_port;
+            if (!ip) throw new Error('no portal ip');
+            var base = 'http://' + ip + ((port && String(port) !== '80') ? ':' + port : '');
+            $('css-open-portal').href = base + '/';
+            frame.src = base + '/?cssprev=1&cssdraft=1';
+            setTimeout(function () {
+                if (!pv.ready) frameMsg.textContent = 'Preview unavailable from this connection (the portal is only reachable from the hotspot network). Your CSS is still validated here; use \u201cOpen portal\u201d from a hotspot device to see it.';
+            }, 9000);
+        }).catch(function () {
+            frameMsg.textContent = 'Could not find the portal address, so there is no preview. Your CSS is still validated here.';
+        });
+    }
+
+    /* ── Load / actions ── */
+    function loadAll() {
+        return api('portal_css_info').then(function (d) {
+            if (!d || !d.ok) throw new Error('info');
+            info = d;
+            return d.has_css ? fetch('/cgi-bin/hotspot.cgi?action=portal_css_get', { cache: 'no-store' }).then(function (r) { return r.text(); }) : '';
+        }).then(function (text) {
+            ed.value = saved = text; loaded = true; showErrors([]); refresh();
+            return pushDraft();
+        }).catch(function () {
+            toastr.error('Could not load the custom CSS settings.');
+        });
+    }
+    function save() {
+        var text = ed.value;
+        if (!text.replace(/\s+/g, '')) { toastr.warning(errText('empty_css')); return; }
+        busy = true; refresh(); clearTimeout(draftTimer);
+        var done = function () { busy = false; refresh(); };
+        pushDraft().then(function (d) {
+            if (!d || !d.ok) { done(); return null; }
+            return new Promise(function (res) {
+                setTimeout(function () { runAudit(function (bad) { res(bad || []); }); }, 500);
+            }).then(function (bad) {
+                if (bad.length && !window.confirm('Customers\u2019 phones would switch your CSS off on these screens:\n\n' + bad.join('\n') + '\n\nSave anyway?')) { done(); return; }
+                return api('portal_css_save', enc(text)).then(function (r) {
+                    if (r.ok) {
+                        saved = text; info.has_css = 1; info.enabled = 1; showErrors([]);
+                        toastr.success('Saved. The portal now uses your CSS.');
+                        return api('portal_css_info').then(function (i) { if (i && i.ok) info = i; done(); });
+                    }
+                    if (r.error === 'invalid_css') showErrors(r.details || ['Invalid CSS.']); else toastr.error(errText(r.error));
+                    done();
+                });
+            });
+        }).catch(function () { toastr.error('Network error. Nothing was changed.'); done(); });
+    }
+    $('css-save').addEventListener('click', save);
+    $('css-discard').addEventListener('click', function () { ed.value = saved; showErrors([]); refresh(); pushDraft(); });
+    $('css-undo').addEventListener('click', function () {
+        busy = true; refresh();
+        api('portal_css_revert', '').then(function (r) {
+            if (r.ok) { toastr.success('Switched to the previous version. Click Undo again to swap back.'); }
+            else toastr.error(errText(r.error));
+        }).catch(function () { toastr.error('Network error.'); }).then(function () { busy = false; return loadAll(); });
+    });
+    $('css-reset').addEventListener('click', function () {
+        if (!window.confirm('Go back to the built-in portal look? Your CSS is kept as the previous version, so you can bring it back with \u201cUndo last save\u201d.')) return;
+        busy = true; refresh();
+        api('portal_css_reset', '').then(function (r) {
+            if (r.ok) toastr.success('Portal is back to the stock look.'); else toastr.error(errText(r.error));
+        }).catch(function () { toastr.error('Network error.'); }).then(function () { busy = false; return loadAll(); });
+    });
+    $('css-enabled').addEventListener('change', function () {
+        var want = this.checked ? 1 : 0, box = this;
+        busy = true; refresh();
