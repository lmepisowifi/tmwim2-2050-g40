From f48e43ffe0318e0bb86fef70ef55e8a8834531a2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 11:26:13 +0000
Subject: [PATCH 06/10] fix auto-reboot schedule: unreachable save, octal
 times, daemon never firing

Functional bug fix (not security), found while reviewing reboot_sched_set.
Three independent defects meant a scheduled reboot could not work:

1. lme.cgi: the immediate-reboot handler tested `grep -q "action=reboot"` (a
   substring match) and sits earlier in the file than action=reboot_sched_set,
   so every schedule save was answered "Missing confirmation" and nothing was
   stored; reboot.html then shows an error. Worse, a schedule POST that did
   include confirm=1 hit the reboot handler and rebooted the router at once.
   The test is now an exact match on the action parameter.

2. lme.cgi: tod_time was written with printf %d, which reads a leading 0 as
   octal. <input type=time> sends "08:30"/"09:09", so 08:xx and xx:08/xx:09
   were saved as hour/minute 0 (08:30 -> 0:30, 04:08 -> 4:00). Leading zeros
   are now stripped before conversion; over-long digit runs are clamped.

3. reboot_sched.sh: the daemon re-pads the stored time with printf %02d, and
   the stored minutes are zero padded, so "9:09"/"4:08" hit the same octal
   error and never matched the clock. Strip leading zeros there too; a corrupt
   or empty value falls back to the same 4:00 default the CGI uses.

Verified under BusyBox 1.36.1: original CGI rejects every schedule save and a
schedule POST with confirm=1 triggers the reboot; patched CGI stores 8:30,
9:09, 4:08 correctly, keeps plain reboot gated on confirm=1, and a schedule
POST with confirm=1 no longer reboots. Daemon run with --once against a fixed
clock: stored 9:09 fires at 09:09 and 4:08 at 04:08 only with the patch.
A scan of every CGI for an earlier action name that is a prefix of a later one
finds no other shadowed handler.

Schedules already saved by an older build are re-saved from the UI.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 www2/cgi-bin/lme.cgi    | 15 ++++++++++++++-
 www2/sh/reboot_sched.sh |  8 ++++++--
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/www2/cgi-bin/lme.cgi b/www2/cgi-bin/lme.cgi
index 1a5f1d8..5bacc79 100755
--- a/www2/cgi-bin/lme.cgi
+++ b/www2/cgi-bin/lme.cgi
@@ -2027,7 +2027,11 @@ if [ "$REQUEST_METHOD" = "POST" ]; then
     fi
 
     # --- action=reboot: immediate device reboot ---
-    if echo "$QUERY_STRING" | busybox grep -q "action=reboot"; then
+    # Exact match only. This used to be a bare substring test, which also caught
+    # action=reboot_sched_set (tested later in this file): saving an auto-reboot
+    # schedule was answered with "Missing confirmation" and never stored, and a
+    # schedule POST that did carry confirm=1 would have rebooted the router.
+    if echo "$QUERY_STRING" | busybox grep -qE '(^|&)action=reboot(&|$)'; then
         FORM_CONFIRM=$(echo "$POST_DATA" \
             | busybox sed -n 's/.*confirm=\([^&]*\).*/\1/p' \
             | busybox tr -d '\r\n')
@@ -2159,6 +2163,15 @@ if [ "$REQUEST_METHOD" = "POST" ]; then
             TOD_MIN=$(echo  "$FORM_TOD" | busybox cut -d':' -f2)
             case "$TOD_HOUR" in ''|*[!0-9]*) TOD_HOUR=4 ;; esac
             case "$TOD_MIN"  in ''|*[!0-9]*) TOD_MIN=0  ;; esac
+            # Read both as DECIMAL. printf %d below (and in reboot_sched.sh)
+            # treats a leading 0 as octal, so "08"/"09" -- exactly what
+            # <input type=time> sends for 08:xx and xx:09 -- errored and were
+            # saved as 0 (08:30 became 0:30, 04:08 became 4:00). Strip leading
+            # zeros; an over-long digit run is clamped by the range checks.
+            TOD_HOUR=$(printf '%s' "$TOD_HOUR" | busybox sed 's/^0*\([0-9]\)/\1/')
+            TOD_MIN=$(printf '%s' "$TOD_MIN" | busybox sed 's/^0*\([0-9]\)/\1/')
+            [ "${#TOD_HOUR}" -gt 2 ] && TOD_HOUR=23
+            [ "${#TOD_MIN}" -gt 2 ] && TOD_MIN=59
             [ "$TOD_HOUR" -gt 23 ] && TOD_HOUR=23
             [ "$TOD_MIN"  -gt 59 ] && TOD_MIN=59
 
diff --git a/www2/sh/reboot_sched.sh b/www2/sh/reboot_sched.sh
index 7e6d066..0707eab 100755
--- a/www2/sh/reboot_sched.sh
+++ b/www2/sh/reboot_sched.sh
@@ -111,8 +111,12 @@ while true; do
                    | busybox cut -d'=' -f2- | busybox tr -d '\r\n')
             NOW=$(get_hhmm)
             # Zero-pad the stored time so comparison works (e.g. "4:0" -> "04:00")
-            TOD_H=$(busybox echo "$TOD" | busybox cut -d':' -f1)
-            TOD_M=$(busybox echo "$TOD" | busybox cut -d':' -f2)
+            # Strip leading zeros first: the stored minutes are zero-padded
+            # ("9:09") and printf %d reads "08"/"09" as invalid octal, which
+            # made the schedule silently never match at xx:08 / xx:09.
+            TOD_H=$(busybox echo "$TOD" | busybox cut -d':' -f1 | busybox sed 's/^0*\([0-9]\)/\1/')
+            TOD_M=$(busybox echo "$TOD" | busybox cut -d':' -f2 | busybox sed 's/^0*\([0-9]\)/\1/')
+            case "$TOD_H$TOD_M" in ''|*[!0-9]*) TOD_H=4; TOD_M=0 ;; esac   # corrupt file: same default as the CGI
             TOD_NORM=$(printf '%02d:%02d' "$TOD_H" "$TOD_M")
             if time_match "$NOW" "$TOD_NORM" && dow_match "$DAYS"; then
                 # Guard: only fire once per minute even if loop is fast
